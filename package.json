{
  "name": "oh-my-pi-token-saver",
  "version": "1.2.0",
  "description": "Amanai reward detector and three toggleable OMP extensions for terse replies, compact shell output, and minimal code decisions — with a manual updater and dry-run support.",
  "keywords": [
    "omp",
    "oh-my-pi",
    "token-saving",
    "ai-tools",
    "developer-tools",
    "caveman-mode",
    "rtk-rust-token-killer",
    "ponytail-omp",
    "extensions",
    "amanai-reward-detector",
    "pi-package"
  ],
  "license": "MIT",
  "author": "KurutoDenzeru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurutoDenzeru/oh-my-pi-token-saver.git"
  },
  "homepage": "https://github.com/KurutoDenzeru/oh-my-pi-token-saver",
  "bugs": {
    "url": "https://github.com/KurutoDenzeru/oh-my-pi-token-saver/issues"
  },
  "type": "module",
  "bin": {
    "oh-my-pi-token-saver": "install-omp-addons.js"
  },
  "omp": {
    "extensions": [
      "./extensions/amanai-reward/index.js"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/amanai-reward/pi.js"
    ]
  },
  "files": [
    "install-omp-addons.js",
    "extensions/**/*.js"
  ],
  "scripts": {
    "clean": "rm -f install-omp-addons.js extensions/**/*.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "doctor": "node install-omp-addons.js --doctor",
    "dry-run": "node install-omp-addons.js --dry-run --scope user --yes",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
